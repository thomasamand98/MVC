# Copier ce fichier en .env (ou .env.local) et renseigner les valeurs réelles.

# URL de base de l'API backend. Laisser vide en dev local pour utiliser
# automatiquement http://<hostname>:3000. En prod, pointer vers l'URL
# publique du backend déployé (ex. https://mvc-backend-production.up.railway.app).
VITE_API_URL=
