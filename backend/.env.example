# Copier ce fichier en .env et renseigner les valeurs réelles (non versionné).

DATABASE_URL="mysql://user:password@localhost:3306/mvc_template"

# Port d'écoute du serveur NestJS. Railway/Render injectent automatiquement
# leur propre valeur ; laisser vide en dev local pour utiliser 3000 par défaut.
PORT=3000

# Origines autorisées en CORS, séparées par des virgules
# (ex. https://mon-front.vercel.app,https://mon-front-preview.vercel.app).
# Laisser vide en dev local : localhost/IP LAN sont autorisés par défaut.
CORS_ORIGIN=

# Adresse de la page des conditions générales de vente : cible du lien « ICI »
# imprimé en pied de page des contrats PDF. Laisser vide : le libellé est
# imprimé sans lien.
CGV_URL=

# ---- Authentification, CORS, limitation de débit ----

# Secret de signature des jetons JWT (obligatoire en production, 32 caractères
# minimum). Générer avec : openssl rand -base64 48
# Absent : un secret temporaire est généré et les sessions sont perdues à
# chaque redémarrage.
JWT_SECRET=

# Cookie de renouvellement de session. Front et API sur le même site
# (localhost, ou app.exemple.be + api.exemple.be) : laisser les valeurs par
# défaut. Front et API sur des domaines différents (ex. deux sous-domaines
# Railway) : COOKIE_SAMESITE=none (impose HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Limites par IP et par minute : toutes routes / tentatives de connexion.
THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=5

# Durée de vie du jeton d'accès, en secondes (900 = 15 minutes par défaut).
# La session est renouvelée automatiquement par le front avant qu'elle ne
# se termine, grâce au cookie de renouvellement (8 h).
ACCESS_TOKEN_TTL_SECONDS=900
